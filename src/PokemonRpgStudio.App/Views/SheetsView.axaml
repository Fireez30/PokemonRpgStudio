<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokemonRpgStudio.App.ViewModels"
             xmlns:c="using:PokemonRpgStudio.App.Controls"
             xmlns:views="using:PokemonRpgStudio.App.Views"
             x:Class="PokemonRpgStudio.App.Views.SheetsView"
             x:DataType="vm:SheetsViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
    <KeyBinding Gesture="Ctrl+PageDown" Command="{Binding NextTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" />
    <KeyBinding Gesture="Ctrl+PageUp" Command="{Binding PreviousTabCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCurrentTabCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Border.sheettab">
      <Setter Property="CornerRadius" Value="8,8,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Border.sheettab:pointerover"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Border.sheettab.active">
      <Setter Property="Background" Value="{DynamicResource HighlightBackground}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.sheettab.active TextBlock.tabname"><Setter Property="FontWeight" Value="Bold" /></Style>
    <Style Selector="Border.sheettab Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.buffed"><Setter Property="Foreground" Value="{DynamicResource GoodText}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.unfinished"><Setter Property="Foreground" Value="#d29922" /></Style>
    <Style Selector="TextBlock.lowered"><Setter Property="Foreground" Value="{DynamicResource BadText}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="ProgressBar.hp"><Setter Property="Foreground" Value="#3fb950" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="ProgressBar.hp.mid"><Setter Property="Foreground" Value="#d29922" /></Style>
    <Style Selector="ProgressBar.hp.low"><Setter Property="Foreground" Value="#e5534b" /></Style>
    <Style Selector="Border.banner">
      <Setter Property="Background" Value="{DynamicResource HighlightBackground}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="Border.row.disabledmove">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="TextBlock.disabledtag">
      <Setter Property="Foreground" Value="{DynamicResource BadText}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- Session note under each section -->
    <DataTemplate DataType="vm:SectionNote">
      <StackPanel Spacing="4" Margin="0,10,0,0">
        <TextBlock Classes="label" Text="Session notes" />
        <TextBox Text="{Binding Text}" Watermark="{Binding Placeholder}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="200" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid ColumnDefinitions="290,*" views:Adaptive.DrawerBelow="640">
    <!-- ── Saved sheets ── -->
    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,14">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <TextBlock Classes="page-title" Text="Sheets" FontSize="22" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="accent" Content="+ New sheet" Command="{Binding NewSheetCommand}" ToolTip.Tip="Opens the Sheet Editor (Ctrl+N)" />
            <Button Content="Import…" Command="{Binding ImportJsonCommand}" ToolTip.Tip="Import sheets: .json files or Markdown (.md) sheets generated by the website" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <ComboBox ItemsSource="{Binding FolderOptions}" SelectedItem="{Binding SelectedFolder}" HorizontalAlignment="Stretch"
                      MaxDropDownHeight="420" ToolTip.Tip="Folder shown in the list (sheets of subfolders are included)">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderOption">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="{Binding Indent}">
                    <TextBlock Text="{Binding Glyph}" />
                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="＋📁" Command="{Binding NewFolderCommand}" Margin="6,0,0,0"
                    ToolTip.Tip="New folder (inside the folder shown)" />
            <Button Grid.Column="2" Content="⋯" Margin="6,0,0,0" MinWidth="32" IsEnabled="{Binding HasFolderSelected}"
                    ToolTip.Tip="Rename or delete the folder shown">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Rename folder…" Command="{Binding RenameFolderCommand}" />
                  <MenuItem Header="Delete folder (keeps its sheets)…" Command="{Binding DeleteFolderCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <CheckBox Content="{Binding IssuesFilterText}" IsChecked="{Binding OnlyIssues}"
                    ToolTip.Tip="Only sheets that are not finished (missing nature, gender, points…) or not correct (abilities or moves the Pokémon can't have, Pokémon not in the Pokédex…)" />
          <TextBox Watermark="Search name, type, move, ability, notes…" Text="{Binding FilterText}"
                   ToolTip.Tip="Searches nickname, Pokémon, types, moves, abilities, nature, rarity, status, level and notes (sheet and session notes). Several words: all must match, e.g. &quot;fire ember&quot;." />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="label" Text="Sort by" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SortOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Content="{Binding SortDirectionGlyph}" Command="{Binding ToggleSortDirectionCommand}"
                    ToolTip.Tip="{Binding SortDirectionTip}" Margin="6,0,0,0" MinWidth="36" FontWeight="Bold" />
          </Grid>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="11" Margin="0,8,0,0"
                   Text="{Binding Sheets.Count, StringFormat='{}{0} saved sheet(s)'}" />
        <ListBox ItemsSource="{Binding FilteredSheets}" SelectedItem="{Binding SelectedListItem}" Margin="0,10,0,0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SheetListItem">
              <Grid ColumnDefinitions="44,*,Auto">
                <Image Width="40" Height="40" Source="{Binding PokemonName, Converter={x:Static c:PokemonImageConverter.Instance}, ConverterParameter=96}" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="⚠" FontSize="15" VerticalAlignment="Center" Margin="6,0,2,0" Background="Transparent"
                           IsVisible="{Binding HasIssues}" Classes.bad="{Binding HasErrors}" Classes.unfinished="{Binding !HasErrors}"
                           ToolTip.Tip="{Binding IssuesTip}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ── Empty state ── -->
    <StackPanel Grid.Column="1" IsVisible="{Binding !HasSheet}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="480">
      <TextBlock Text="Pokémon sheets" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
      <TextBlock Classes="muted" TextAlignment="Center"
                 Text="Pick a sheet on the left to use it in a game (each sheet opens in its own tab): track hit points, injuries and stat changes, roll attacks and skills, export it or add it to a team. Create and change sheets in the Sheet Editor." />
      <Button Classes="accent" Content="+ Create a new sheet" Command="{Binding NewSheetCommand}" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- ── Sheet in use ── -->
    <DockPanel Grid.Column="1" IsVisible="{Binding HasSheet}">
      <!-- open sheets (tabs) -->
      <Border DockPanel.Dock="Top" Padding="12,8,12,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SheetTab">
                  <Border Classes="sheettab" Classes.active="{Binding IsActive}">
                    <StackPanel Orientation="Horizontal">
                      <Button Command="{Binding ActivateCommand}" Padding="8,4,4,4" ToolTip.Tip="{Binding Nickname}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Image Width="24" Height="24" Source="{Binding PokemonName, Converter={x:Static c:PokemonImageConverter.Instance}, ConverterParameter=96}" />
                          <TextBlock Classes="tabname" Text="{Binding Nickname}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Content="✕" Command="{Binding CloseCommand}" Padding="6,4" FontSize="11" VerticalAlignment="Center"
                              ToolTip.Tip="Close this tab (Ctrl+W)" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Grid.Column="1" Classes="small" Content="Close others" Command="{Binding CloseOtherTabsCommand}" IsVisible="{Binding HasSeveralTabs}"
                  VerticalAlignment="Center" Margin="8,0,0,6" ToolTip.Tip="Keep only the sheet shown. Switch tabs with Ctrl+Tab / Ctrl+Shift+Tab" />
        </Grid>
      </Border>
      <!-- toolbar -->
      <Border DockPanel.Dock="Top" Padding="20,12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" views:Adaptive.StackBelow="620">
          <WrapPanel ItemSpacing="10" LineSpacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding Nickname}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SpeciesName}" Classes="muted" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding MoveFolderOptions}" SelectedItem="{Binding SheetFolder}" MinWidth="150" MaxWidth="240"
                      VerticalAlignment="Center" Margin="8,0,0,0" MaxDropDownHeight="420" ToolTip.Tip="Folder of this sheet: pick one to move it">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderOption">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="{Binding Indent}">
                    <TextBlock Text="{Binding Glyph}" />
                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </WrapPanel>
          <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="6">
            <Button Classes="accent" Content="✏ Edit" Command="{Binding EditCommand}" ToolTip.Tip="Open in the Sheet Editor (Ctrl+E)" />
            <Button Content="Export ▾">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Copy for Google Docs" Command="{Binding CopyGoogleDocCommand}" />
                  <MenuItem Header="Copy Markdown" Command="{Binding CopyMarkdownCommand}" />
                  <MenuItem Header="Export Markdown…" Command="{Binding ExportMarkdownCommand}" />
                  <MenuItem Header="Export HTML…" Command="{Binding ExportHtmlCommand}" />
                  <Separator />
                  <MenuItem Header="Export sheet file (.json)…" Command="{Binding ExportJsonCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Content="Duplicate" Command="{Binding DuplicateCommand}" />
            <Button Classes="danger" Content="Delete" Command="{Binding DeleteCommand}" />
          </WrapPanel>
        </Grid>
      </Border>

      <!-- sheet + roll log (right side, with "add to a team"); narrow: the roll log slides in from the right (🎲 button) -->
      <Grid ColumnDefinitions="*,290" views:Adaptive.DrawerBelow="760" views:Adaptive.DrawerGlyph="🎲">
        <ScrollViewer>
          <StackPanel Margin="20,16" Grid.IsSharedSizeScope="True">
            <Border Classes="banner" IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="bad" Text="{Binding Warning}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="banner" IsVisible="{Binding ErrorsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <SelectableTextBlock Classes="bad" Text="{Binding ErrorsText}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="banner" IsVisible="{Binding IncompleteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding IncompleteText}" TextWrapping="Wrap" />
            </Border>

            <!-- identity -->
            <Border Classes="card">
              <Grid ColumnDefinitions="Auto,*">
                <Border Classes="subtle" Width="112" Height="112" Margin="0,0,16,0" VerticalAlignment="Top">
                  <Image Source="{Binding ImageName, Converter={x:Static c:PokemonImageConverter.Instance}}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                  <c:TypeBadges Types="{Binding Types}" BadgeFontSize="13" />
                  <WrapPanel>
                    <Border Classes="chip"><TextBlock Text="{Binding LevelText}" FontWeight="Bold" /></Border>
                    <Border Classes="chip"><TextBlock Text="{Binding ExperienceText}" /></Border>
                    <Border Classes="chip"><TextBlock Text="{Binding RarityText, StringFormat='Rarity {0}'}" /></Border>
                    <Border Classes="chip"><TextBlock Text="{Binding CardText, StringFormat='Card {0}'}" /></Border>
                    <Border Classes="chip"><TextBlock Text="{Binding GenderText}" /></Border>
                    <Border Classes="chip"><TextBlock Text="{Binding NatureText}" FontWeight="SemiBold" /></Border>
                  </WrapPanel>
                  <TextBlock Text="{Binding SizeText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <StackPanel Spacing="2" Margin="0,4,0,0" IsVisible="{Binding Matchups.HasGroups}">
                    <TextBlock Classes="label" Text="Damage taken" ToolTip.Tip="Multiplier of each attacking type on this Pokémon's types (neutral ×1 types are not listed)" />
                    <views:TypeMatchupsView DataContext="{Binding Matchups}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- hit points -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Classes="section-title" Text="Hit points" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <ProgressBar Grid.Column="1" Classes="hp" Classes.mid="{Binding IsHpMid}" Classes.low="{Binding IsHpLow}"
                               Minimum="0" Maximum="{Binding MaxHp}" Value="{Binding CurrentHp}" Height="16" MinWidth="80" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                    <TextBlock Text="{Binding HpText}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="Fainted" Classes="bad" FontWeight="Bold" VerticalAlignment="Center" IsVisible="{Binding IsFainted}" />
                  </StackPanel>
                </Grid>
                <WrapPanel>
                  <NumericUpDown Value="{Binding HpAmount}" Minimum="0" Maximum="999" Width="120" FormatString="0" Margin="0,0,6,6" />
                  <Button Content="− Damage" Command="{Binding DamageCommand}" Margin="0,0,6,6" />
                  <Button Content="{Binding TickLabel}" Command="{Binding TakeTickCommand}" Margin="0,0,6,6"
                          ToolTip.Tip="Take a tick of damage: 1/10 of the max HP (poison, burn, weather…)" />
                  <Button Content="+ Heal" Command="{Binding HealCommand}" Margin="0,0,6,6" />
                  <Button Content="{Binding HealTickLabel}" Command="{Binding HealTickCommand}" Margin="0,0,6,6"
                          ToolTip.Tip="Heal a tick: 1/10 of the max HP" />
                  <Button Content="{Binding HealHalfLabel}" Command="{Binding HealHalfCommand}" Margin="0,0,6,6"
                          ToolTip.Tip="Heal half of the max HP" />
                  <Button Content="+ Max HP" Command="{Binding RaiseMaxHpCommand}" Margin="0,0,6,6" ToolTip.Tip="Temporary bonus to the maximum hit points (the HP are gained too)" />
                  <Button Content="− Max HP" Command="{Binding LowerMaxHpCommand}" Margin="0,0,6,6" ToolTip.Tip="Temporary malus to the maximum hit points" />
                  <Button Content="Reset temp stats" Command="{Binding ResetTempStatsCommand}" IsEnabled="{Binding HasTempChanges}" Margin="0,0,6,6"
                          ToolTip.Tip="Remove every temporary change: stat bonuses, combat stages, skill bonuses and max HP change. HP, injuries and disabled moves are kept." />
                  <Button Content="Rest" Command="{Binding RestCommand}" Margin="0,0,18,6"
                          ToolTip.Tip="HP back to the max (reduced by the injuries), and every temporary change removed (stats, skills, max HP, disabled moves). Injuries and notes are kept." />
                </WrapPanel>
                <Border Classes="subtle">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="🩹" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" Grid.RowSpan="2" />
                    <TextBlock Grid.Column="1" Text="{Binding InjuryInfo}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Classes.bad="{Binding HasInjuries}" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding NextInjuryText, StringFormat='{}{0} · damage: 1 injury per 25 % of the sheet max HP marker passed · a hit of more than 50 % of max HP: +1 injury · each injury: −1/10 max HP · healing never removes injuries: use − to remove one'}" />
                    <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Classes="label" Text="Injuries" ToolTip.Tip="Every injury (damage, massive damage, added by hand). Healing and Rest don't remove them: only the − button does" />
                      <Button Classes="small" Content="−" Command="{Binding RemoveInjuryCommand}" ToolTip.Tip="Remove an injury" />
                      <TextBlock Text="{Binding Injuries}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" MinWidth="16" TextAlignment="Center" />
                      <Button Classes="small" Content="+" Command="{Binding AddInjuryCommand}" ToolTip.Tip="Add an injury from another source" />
                    </StackPanel>
                  </Grid>
                </Border>
                <WrapPanel>
                  <TextBlock Text="{Binding MaxHpInfo}" Classes="muted" Margin="0,0,6,0" VerticalAlignment="Center" Classes.bad="{Binding IsMaxHpReduced}" />
                  <Button Classes="small" Content="✕ temp" Command="{Binding ResetTempMaxHpCommand}" IsVisible="{Binding HasTempMaxHp}" Margin="0,0,24,0" ToolTip.Tip="Remove the temporary max HP change" />
                  <TextBlock Classes="label" Text="Evades" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Evades}" FontWeight="SemiBold" Margin="0,0,24,0" />
                  <TextBlock Text="{Binding TutorPoints, StringFormat='Tutor points: {0}'}" Classes="muted" />
                </WrapPanel>
                <ContentControl Content="{Binding NoteHp}" />
              </StackPanel>
            </Border>

            <!-- stats -->
            <Border Classes="card">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section-title" Text="Stats" />
                  <Button Grid.Column="1" Classes="small" Content="Clear temp bonuses" Command="{Binding ResetStatModifiersCommand}" IsVisible="{Binding HasStatModifiers}" />
                </Grid>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="− / + add a temporary malus or bonus to a stat; ±1 CS adds a combat stage (20 % of the sheet value per stage, −6 to +6). The current value is used for damage, evades and custom rolls." />
                <Grid ColumnDefinitions="90,170,70,150,*">
                  <TextBlock Classes="th" Text="Stat" />
                  <TextBlock Grid.Column="1" Classes="th" Text="Base + buff + points" />
                  <TextBlock Grid.Column="2" Classes="th" Text="Sheet" />
                  <TextBlock Grid.Column="3" Classes="th" Text="Current (temp)" />
                  <TextBlock Grid.Column="4" Classes="th" Text="Combat stages" Margin="20,2,4,2" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Stats}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayStatRow">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="90,170,70,150,*">
                          <TextBlock Classes="td" Text="{Binding Label}" FontWeight="SemiBold" Classes.buffed="{Binding IsBuffed}" Classes.lowered="{Binding IsLowered}" />
                          <TextBlock Grid.Column="1" Classes="td" Text="{Binding Formula}" Foreground="{DynamicResource MutedText}" />
                          <TextBlock Grid.Column="2" Classes="td" Text="{Binding Max}" FontWeight="Bold" />
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="small" Content="−" Command="{Binding DecreaseCommand}" />
                            <TextBlock Text="{Binding Current}" FontWeight="Bold" FontSize="16" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button Classes="small" Content="+" Command="{Binding IncreaseCommand}" />
                            <TextBlock Text="{Binding ModifierText}" VerticalAlignment="Center" Classes.good="{Binding IsRaised}" Classes.bad="{Binding IsDropped}" />
                          </StackPanel>
                          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Classes="small" Content="−1 CS" Command="{Binding LowerStageCommand}" ToolTip.Tip="{Binding StageTip}" />
                            <Button Classes="small" Content="+1 CS" Command="{Binding RaiseStageCommand}" ToolTip.Tip="{Binding StageTip}" />
                            <TextBlock Text="{Binding StagesText}" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Classes.good="{Binding IsStageUp}" Classes.bad="{Binding IsStageDown}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ContentControl Content="{Binding NoteStats}" />
              </StackPanel>
            </Border>

            <!-- moves -->
            <Border Classes="card">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section-title" Text="Moves" />
                  <Button Grid.Column="1" Classes="small" Content="Enable all" Command="{Binding EnableAllMovesCommand}" IsVisible="{Binding HasDisabledMoves}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Moves}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayMoveRow">
                      <StackPanel>
                        <Border Height="2" Background="{DynamicResource AccentText}" Margin="0,8" IsVisible="{Binding StartsSecondTable}" Opacity="0.6" />
                        <Border Classes="row" Classes.disabledmove="{Binding IsDisabled}" Padding="0,4">
                          <Grid RowDefinitions="Auto,Auto">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="22" />
                              <ColumnDefinition Width="*" MinWidth="110" />
                              <ColumnDefinition Width="Auto" SharedSizeGroup="ptype" />
                              <ColumnDefinition Width="72" />
                              <ColumnDefinition Width="Auto" SharedSizeGroup="pclass" />
                              <ColumnDefinition Width="Auto" SharedSizeGroup="pbtn" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="td" Text="{Binding Number}" Foreground="{DynamicResource MutedText}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <TextBlock Classes="td" Text="{Binding Name}" FontWeight="SemiBold" />
                              <TextBlock Classes="disabledtag" Text="DISABLED" IsVisible="{Binding IsDisabled}" VerticalAlignment="Center" />
                            </StackPanel>
                            <c:TypeBadges Grid.Column="2" Types="{Binding Types}" Margin="4,0" />
                            <TextBlock Grid.Column="3" Classes="td" Text="{Binding Roll}" FontFamily="monospace" FontWeight="SemiBold" />
                            <c:ClassBadge Grid.Column="4" ClassName="{Binding Class}" Margin="4,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0,0,0">
                              <Button Classes="small" Content="🎯 Accuracy" Command="{Binding Accuracy}"
                                      ToolTip.Tip="Roll accuracy (d20 against the AC). A natural 20 makes the next damage roll critical" />
                              <Button Classes="small" Content="{Binding DamageLabel}" Command="{Binding Damage}" IsVisible="{Binding HasDamage}"
                                      Classes.accent="{Binding CritReady}" ToolTip.Tip="{Binding DamageTip}">
                                <Button.ContextFlyout>
                                  <MenuFlyout>
                                    <MenuItem Header="Cancel the critical" Command="{Binding CancelCritCommand}" IsEnabled="{Binding CritReady}" />
                                    <MenuItem Header="Next damage roll is critical" Command="{Binding ForceCritCommand}" IsEnabled="{Binding !CritReady}" />
                                  </MenuFlyout>
                                </Button.ContextFlyout>
                              </Button>
                              <ToggleButton Classes="small" Content="{Binding DisableLabel}" IsChecked="{Binding IsDisabled, Mode=OneWay}"
                                            Command="{Binding ToggleDisabledCommand}" Padding="8,2" FontSize="12" MinHeight="24"
                                            ToolTip.Tip="Disable this move for now (Disable, Torment, no PP…)" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="4,0,4,2" Spacing="1">
                              <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource AccentText}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Effect}" FontSize="12" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" FontSize="12" Margin="0,6,0,0" Text="No moves yet: edit the sheet to add some." IsVisible="{Binding HasNoMoves}" />
                <ContentControl Content="{Binding NoteMoves}" />
              </StackPanel>
            </Border>

            <!-- custom roll -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="Custom roll" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Roll any attack yourself: an accuracy check against your own AC (a 20 is a critical hit: twice as many damage dice) and your own damage expression, plus any stats of this Pokémon (current values)." />
                <WrapPanel>
                  <StackPanel Margin="0,0,12,8" Spacing="4">
                    <TextBlock Classes="label" Text="Name (optional)" />
                    <TextBox Width="170" Text="{Binding CustomName}" Watermark="e.g. Flamethrower" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,8" Spacing="4">
                    <CheckBox Content="AC check" IsChecked="{Binding CustomUseAc}" Padding="4,0" MinHeight="0" />
                    <NumericUpDown Value="{Binding CustomAc}" Minimum="0" Maximum="30" Width="120" FormatString="0" IsEnabled="{Binding CustomUseAc}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,8" Spacing="4">
                    <TextBlock Classes="label" Text="Damage expression" />
                    <TextBox Width="150" Text="{Binding CustomDamage}" Watermark="2d8+10" FontFamily="monospace">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding CustomAttackCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                  </StackPanel>
  <StackPanel Margin="0,0,12,8" Spacing="4">
                    <TextBlock Classes="label" Text="+ Stats (pick any)" />
                    <ItemsControl ItemsSource="{Binding CustomStats}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CustomStatOption">
                          <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,4,0" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding CustomStatsSummary}" />
                  </StackPanel>
                </WrapPanel>
                <WrapPanel>
                  <Button Classes="accent" Content="🎲 Roll attack" Command="{Binding CustomAttackCommand}" Margin="0,0,6,6" ToolTip.Tip="Accuracy check + damage (Enter)" />
                  <Button Content="Accuracy only" Command="{Binding CustomAccuracyCommand}" Margin="0,0,6,6" />
                  <Button Content="Damage only" Command="{Binding CustomDamageRollCommand}" Margin="0,0,12,6" />
                  <CheckBox Content="Critical hit (twice as many dice)" IsChecked="{Binding CustomForceCrit}" Margin="0,0,0,6" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- abilities / skills / capabilities -->
            <Grid ColumnDefinitions="*,16,*">
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section-title" Text="Abilities" />
                  <TextBlock Classes="muted" Text="No ability chosen." IsVisible="{Binding HasNoAbilities}" />
                  <ItemsControl ItemsSource="{Binding Abilities}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AbilityInfo">
                        <StackPanel Margin="0,0,0,10" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                          <TextBlock Text="{Binding Effect}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ContentControl Content="{Binding NoteAbilities}" />
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="2">
                <Border Classes="card">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="section-title" Text="Skills" />
                      <Button Grid.Column="1" Classes="small" Content="Clear bonuses" Command="{Binding ResetSkillModifiersCommand}" IsVisible="{Binding HasSkillModifiers}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Skills}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaySkillRow">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,1">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding EffectiveRoll}" FontWeight="SemiBold" FontFamily="monospace" VerticalAlignment="Center" Margin="8,0"
                                       Classes.good="{Binding IsBonus}" Classes.bad="{Binding IsMalus}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="0,0,6,0" VerticalAlignment="Center">
                              <Button Classes="small" Content="−" Command="{Binding DecreaseCommand}" ToolTip.Tip="Malus to this skill's rolls" />
                              <Button Classes="small" Content="+" Command="{Binding IncreaseCommand}" ToolTip.Tip="Bonus to this skill's rolls" />
                            </StackPanel>
                            <Button Grid.Column="3" Classes="small" Content="🎲" Command="{Binding RollCommand}" IsEnabled="{Binding CanRoll}" ToolTip.Tip="Roll this skill (bonus included)" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentControl Content="{Binding NoteSkills}" />
                  </StackPanel>
                </Border>
                <Border Classes="card">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="section-title" Text="Capabilities" />
                    <ItemsControl ItemsSource="{Binding Capabilities}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeyValueRow">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                            <TextBlock Text="{Binding Key}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Margin="8,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentControl Content="{Binding NoteCapabilities}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <!-- other moves & notes -->
            <Border Classes="card">
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Classes="label" Text="Egg moves" />
                <TextBlock Grid.Column="1" Text="{Binding EggMovesText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Classes="label" Text="TM moves" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TmMovesText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Classes="label" Text="Tutor moves" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TutorMovesText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Classes="label" Text="Tutor notes" VerticalAlignment="Top" IsVisible="{Binding HasTutorNotes}" />
                <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TutorNotes}" TextWrapping="Wrap" IsVisible="{Binding HasTutorNotes}" />
                <TextBlock Grid.Row="4" Classes="label" Text="Notes" VerticalAlignment="Top" IsVisible="{Binding HasNotes}" />
                <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Notes}" TextWrapping="Wrap" IsVisible="{Binding HasNotes}" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0">
          <DockPanel Margin="14,16">
            <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="Add to a team" />
                <TextBlock Classes="muted" FontSize="12" Text="Create teams in the Team Manager page." IsVisible="{Binding HasNoTeams}" />
                <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" PlaceholderText="Team…" HorizontalAlignment="Stretch" />
                <Grid ColumnDefinitions="*,Auto">
                  <ComboBox ItemsSource="{Binding TeamSlots}" SelectedItem="{Binding SelectedTeamSlot}" PlaceholderText="Slot…" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="1" Content="Add" Command="{Binding AddToTeamCommand}" Margin="6,0,0,0" />
                </Grid>
              </StackPanel>
            </Border>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Classes="section-title" Text="Rolls" Margin="0" />
              <Button Grid.Column="1" Classes="small" Content="Clear" Command="{Binding ClearLogCommand}" IsVisible="{Binding HasRolls}" />
            </Grid>
            <Panel>
              <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding !HasRolls}" TextWrapping="Wrap"
                         Text="Use the Attack, Damage, skill and custom roll buttons: results appear here." />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding RollLog}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RollLogEntry">
                      <Border Classes="subtle" Margin="0,0,0,6">
                        <StackPanel Spacing="2">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="muted" FontSize="11" Margin="6,0,0,0" />
                          </Grid>
                          <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
