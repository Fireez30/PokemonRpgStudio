<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PokemonRpgStudio.App.ViewModels"
        xmlns:views="using:PokemonRpgStudio.App.Views"
        x:Class="PokemonRpgStudio.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Pokémon RPG Studio"
        Icon="/Assets/app-icon.png"
        Width="1440" Height="900" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackground}">
  <!-- The application itself is MainView (shared with Android). -->
  <views:MainView />
</Window>
