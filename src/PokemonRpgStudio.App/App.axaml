<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PokemonRpgStudio.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBackground" Color="#17151f" />
          <SolidColorBrush x:Key="SidebarBackground" Color="#110f18" />
          <SolidColorBrush x:Key="CardBackground" Color="#211e2c" />
          <SolidColorBrush x:Key="CardBorder" Color="#342e46" />
          <SolidColorBrush x:Key="SubtleBackground" Color="#2a2639" />
          <SolidColorBrush x:Key="MutedText" Color="#a49dba" />
          <SolidColorBrush x:Key="AccentText" Color="#b99aff" />
          <SolidColorBrush x:Key="GoodText" Color="#66d17a" />
          <SolidColorBrush x:Key="BadText" Color="#ff6b6b" />
          <SolidColorBrush x:Key="StatBar" Color="#9b6cf0" />
          <SolidColorBrush x:Key="HighlightBackground" Color="#30264a" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBackground" Color="#f4f1fa" />
          <SolidColorBrush x:Key="SidebarBackground" Color="#e8e1f5" />
          <SolidColorBrush x:Key="CardBackground" Color="#ffffff" />
          <SolidColorBrush x:Key="CardBorder" Color="#dbd2ec" />
          <SolidColorBrush x:Key="SubtleBackground" Color="#f2edfb" />
          <SolidColorBrush x:Key="MutedText" Color="#645c78" />
          <SolidColorBrush x:Key="AccentText" Color="#6a3fc4" />
          <SolidColorBrush x:Key="GoodText" Color="#2e8b3d" />
          <SolidColorBrush x:Key="BadText" Color="#c62828" />
          <SolidColorBrush x:Key="StatBar" Color="#8a5ce6" />
          <SolidColorBrush x:Key="HighlightBackground" Color="#ece2ff" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Color x:Key="SystemAccentColor">#7C4DDB</Color>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.page-subtitle">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.good">
      <Setter Property="Foreground" Value="{DynamicResource GoodText}" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="{DynamicResource BadText}" />
    </Style>
    <Style Selector="TextBlock.th">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="4,2" />
    </Style>
    <Style Selector="TextBlock.td">
      <Setter Property="Margin" Value="4,3" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="Border.subtle">
      <Setter Property="Background" Value="{DynamicResource SubtleBackground}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource SubtleBackground}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,6,4" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,2" />
    </Style>
    <Style Selector="Border.row.locked">
      <Setter Property="Background" Value="{DynamicResource HighlightBackground}" />
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#b3392c" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="ToggleButton.chip">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="8,2" />
    </Style>
  </Application.Styles>
</Application>
